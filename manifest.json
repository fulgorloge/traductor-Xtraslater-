{
  "manifest_version": 3,
  "name": "Xtranslater",
  "version": "1.3.0",
  "description": "Traducción flotante instantánea, reemplazo de texto en tiempo real, historial local y lectura por voz.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://translate.googleapis.com/*",
    "https://api.mymemory.translated.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Xtranslater"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "commands": {
    "trigger-translation": {
      "suggested_key": {
        "default": "Alt+T"
      },
      "description": "Traducir texto seleccionado"
    }
  }
}
